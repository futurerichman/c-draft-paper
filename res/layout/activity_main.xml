<?xml version="1.0" encoding="utf-8"?>
<!-- v1.28：图片背景与视频背景实现方式分离，并提供两种视频模式（二选一）。
     根布局 FrameLayout：
       图层1（最底）：vvBgFull 全屏视频（"全屏模式"，不压缩、centerCrop 保比例）
       图层2（最上）：全部软件 UI（背景透明，让全屏视频在编辑区透出；
                       工具栏/控制台/符号栏自身不透明，遮挡视频）
     编辑区 editorContainer 内（v1.24 方式，"编辑区模式"）：
       ivBg 图片背景、vvBg 视频背景 —— 只占编辑区，随编辑区/旋转改变比例。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e">

    <!-- ===== 全屏视频层（"全屏模式"，最低图层，铺满整个屏幕） ===== -->
    <TextureView
        android:id="@+id/vvBgFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== 软件 UI 层（背景透明；工具栏/控制台/符号栏各自不透明） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true">

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2d2d30"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <!-- v1.13-UI：原「新建」「打开」「保存」三按钮合并为一个「文件」按钮，点开是弹出菜单 -->
            <Button
                android:id="@+id/btnFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="文件"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <Button
                android:id="@+id/btnRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <!-- v1.28.7：把单步执行功能独立放到工具栏上，复用现有单步调试逻辑 -->
            <Button
                android:id="@+id/btnStepToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="步过"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <!-- v1.14-UI：更多菜单（v1.21 起：设置背景 / 背景透明度 / 视频模式 / 关于作者） -->
            <TextView
                android:id="@+id/btnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="⋮"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="untitled.c"
                android:textSize="13sp"
                android:textColor="#9cdcfe"
                android:gravity="end"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnToggleToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="收起"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <!-- 工具栏收起后的窄条（默认隐藏） -->
        <LinearLayout
            android:id="@+id/toolbarCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2d2d30"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnShowToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ 展开工具栏"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- 代码编辑区（v1.28：背景透明，让全屏视频透出；内部保留图片/inline视频背景） -->
        <FrameLayout
            android:id="@+id/editorContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <!-- 图片背景（v1.24 方式：只在编辑区，scaleType=centerCrop，透明度 bg_opac） -->
            <ImageView
                android:id="@+id/ivBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="代码区背景图" />

            <!-- 编辑区模式视频（v1.24 方式：只占编辑区，会随编辑区/旋转改变比例） -->
            <TextureView
                android:id="@+id/vvBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.ccode.mintest.CCodeEditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#d4d4d4"
                android:textColorHint="#6a6a6a"
                android:textSize="14sp"
                android:typeface="monospace"
                android:gravity="top|start"
                android:paddingStart="54dp"
                android:paddingEnd="10dp"
                android:paddingVertical="8dp"
                android:hint="在这里输入 C 语言代码…"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />

            <!-- v1.28.9：编辑区左侧行号栏（覆盖 etCode 左 44dp 区域，文本已用 paddingStart 避让） -->
            <com.ccode.mintest.CLineNumberView
                android:id="@+id/lineNumbers"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="left|top" />
        </FrameLayout>

        <!-- 底部控制台 -->
        <LinearLayout
            android:id="@+id/console"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="#0d0d0d">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1a1a1a"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="控制台"
                    android:textSize="12sp"
                    android:textColor="#8a8a8a" />

                <TextView
                    android:id="@+id/btnToggleConsole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="收起"
                    android:textSize="12sp"
                    android:textColor="#9cdcfe"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scConsole"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:textColor="#cccccc"
                    android:textIsSelectable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </ScrollView>

            <!-- 程序输入行（运行期间出现） -->
            <LinearLayout
                android:id="@+id/inputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1a1a1a"
                android:padding="4dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252526"
                    android:textColor="#d4d4d4"
                    android:textColorHint="#6a6a6a"
                    android:textSize="14sp"
                    android:typeface="monospace"
                    android:singleLine="true"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:hint="程序等待输入（scanf）…" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="发送"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_bg_run"
                    android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 控制台收起后的窄条（默认隐藏） -->
        <LinearLayout
            android:id="@+id/consoleCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnShowConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ 展开控制台"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- v1.18：单步调试控制条（默认隐藏，调试时显示） -->
        <LinearLayout
            android:id="@+id/debugBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#243b3b"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步过"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="继续"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnBreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="断点"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnStopDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="停止"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:minWidth="48dp" />

            <TextView
                android:id="@+id/tvDebugStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 底部常用符号栏 -->
        <HorizontalScrollView
            android:id="@+id/symbolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2d2d30"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/symbolRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
